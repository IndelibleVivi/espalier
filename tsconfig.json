{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@espalier/protocol": ["packages/protocol/src/index.ts"],
      "@espalier/core": ["packages/core/src/index.ts"],
      "@espalier/context-compiler": ["packages/context-compiler/src/index.ts"],
      "@espalier/projections": ["packages/projections/src/index.ts"],
      "@espalier/client": ["packages/client/src/index.ts"],
      "@espalier/adapters": ["packages/adapters/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
